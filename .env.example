# =============================================
# KoopPilot — Environment Variables
# =============================================

# Google Gemini API Key (AI Agent için zorunlu)
GOOGLE_API_KEY=

# Telegram Bot Token'ları (BotFather'dan alınır)
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_CUSTOMER_BOT_TOKEN=

# Admin Telegram User ID'leri (virgülle ayrılmış)
# Boş bırakılırsa demo modda herkes admin olur
TELEGRAM_ADMIN_USER_IDS=

# Backend URL (Docker dışında çalışırken değiştirin)
# Docker içinde otomatik olarak http://backend:8000 kullanılır
# BACKEND_URL=http://localhost:8000

# Twilio (opsiyonel — WhatsApp entegrasyonu için)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=